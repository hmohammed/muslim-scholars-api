# Copy to .env for local development. Never commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://msapi:msapi@localhost:5433/msapi
TEST_DATABASE_URL=postgres://msapi:msapi@localhost:5433/msapi_test

# API
PORT=3000
LOG_LEVEL=info

# Importer: folder holding the crawled <ID>.html pages
RAW_HTML_DIR=../islamic-scholars-dashboard-full/data-raw/muslimscholars/html

# M4. Create these yourself. Never commit real values.
# GitHub OAuth app callback: http://localhost:3000/portal/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SESSION_KEY=
# API_KEY_PEPPER=
# Comma-separated GitHub usernames that should be admin.
# ADMIN_GITHUB_LOGINS=
# PUBLIC_URL=http://localhost:3000
# SENTRY_DSN=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
